<?xml version='1.0'?>
<sdf version='1.7'>

  <world name='faculty_world'>

    <!-- SCENE -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.65 0.78 0.95 1</background>
      <shadows>true</shadows>
      <sky>
        <time>10</time>
        <sunrise>6</sunrise>
        <sunset>18</sunset>
        <clouds>
          <speed>2</speed>
          <humidity>0.5</humidity>
          <mean_size>0.5</mean_size>
          <ambient>0.8 0.8 0.8 1</ambient>
        </clouds>
      </sky>
      <fog>
        <color>0.8 0.85 0.9 1</color>
        <type>linear</type>
        <start>500</start>
        <end>1200</end>
        <density>0.001</density>
      </fog>
    </scene>

    <!-- SUN -->
    <light type='directional' name='sun'>
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.95 0.92 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- PHYSICS -->
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>-1</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.0</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.0</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <gravity>0 0 -9.81</gravity>

    <!-- GPS ORIGIN: Faculty of Engineering, University of Ruhuna -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>6.07778</latitude_deg>
      <longitude_deg>80.20722</longitude_deg>
      <elevation>30</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- ATMOSPHERE -->
    <atmosphere type='adiabatic'>
      <temperature>305</temperature>
      <pressure>101325</pressure>
      <temperature_gradient>-0.0065</temperature_gradient>
    </atmosphere>

    <!-- MAGNETIC FIELD: Galle, Sri Lanka -->
    <magnetic_field>9.5e-6 4.08e-5 -9.0e-6</magnetic_field>

    <!-- WIND -->
    <wind>
      <linear_velocity>1.5 0.5 0</linear_velocity>
    </wind>

    <!-- CAMERA -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <!-- Terrain surface near origin is Z≈39m (GPS-absolute coords).
             Camera sits 12m above terrain, angled 47° down at drones. -->
        <pose>0 -3 51 0 0.817 1.5707</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- ============================================================ -->
    <!-- TERRAIN                                                      -->
    <!-- ============================================================ -->
    <model name='terrain'>
      <static>true</static>
      <link name='terrain_link'>
        <visual name='terrain_visual'>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <mesh>
              <uri>model://faculty_meshes/terrain.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='terrain_collision'>
          <geometry>
            <mesh>
              <uri>model://faculty_meshes/terrain.dae</uri>
            </mesh>
          </geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
            <contact><ode><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <!-- ============================================================ -->
    <!-- BUILDINGS                                                    -->
    <!-- ============================================================ -->

    <model name='administration_building'>
      <static>true</static>
      <link name='link'>
        <visual name='visual'><cast_shadows>true</cast_shadows>
          <geometry><mesh><uri>model://faculty_meshes/buildings/Administration_Building.dae</uri></mesh></geometry>
          <material><ambient>0.91 0.88 0.80 1</ambient><diffuse>0.89 0.85 0.77 1</diffuse><specular>0.06 0.06 0.05 1</specular><emissive>0 0 0 1</emissive></material>
        </visual>
        <collision name='collision'>
          <geometry><mesh><uri>model://faculty_meshes/buildings/Administration_Building.dae</uri></mesh></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
      </link>
      <pose>0 0 -0.60 0 0 0</pose>
    </model>

    <model name='administration_building_roof'>
      <static>true</static>
      <link name='link'>
        <visual name='visual'><cast_shadows>true</cast_shadows>
          <geometry><mesh><uri>model://faculty_meshes/buildings/Administration_Building_Roof.dae</uri></mesh></geometry>
          <material><ambient>0.62 0.28 0.14 1</ambient><diffuse>0.58 0.24 0.11 1</diffuse><specular>0.08 0.05 0.03 1</specular><emissive>0 0 0 1</emissive></material>
        </visual>
        <collision name='collision'>
          <geometry><mesh><uri>model://faculty_meshes/buildings/Administration_Building_Roof.dae</uri></mesh></geometry>
          <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
      </link>
      <pose>0 0 -0.60 0 0 0</pose>
    </model>

