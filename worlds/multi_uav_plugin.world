<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <gui>
      <camera name="user_camera">
        <pose>2 -10 6 0 0.6 1.57</pose>
      </camera>
    </gui>
    <physics type="ode">
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.0</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.0</contact_surface_layer>
        </constraints>
      </ode>
      <real_time_update_rate>-1</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
    <specular>0.2 0.2 0.2 1</specular>
    <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
    </attenuation>
    <direction>-0.5 0.1 -0.9</direction>
    </light>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.5 0.7 0.9 1</background>
      <shadows>false</shadows>
    </scene>
    
    
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5000 5000</size>
            </plane>
          </geometry>
        </collision>
        <visual name="grass">
          <pose>0 0 -0.1 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5000 5000</size>
            </plane>
          </geometry>
          <material>
            <script>
               <uri>file://media/materials/scripts/gazebo.material</uri>
               <name>Gazebo/Grass</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Wall obstacle: 1m thick, 3m wide, 8m tall, so it blocks the
         UAV0<->UAV1 link at flight altitude. "concrete" in the name
         selects the 15 dB material loss in the raycast plugin. -->
    <model name="glass_wall">
  <static>false</static>
  <pose>0 0 4 0 0 0</pose>

  <link name="link">
    <collision name="collision">
      <geometry>
        <box>
          <size>1 3 8</size>
        </box>
      </geometry>
    </collision>

    <visual name="visual">
      <geometry>
        <box>
          <size>1 3 8</size>
        </box>
      </geometry>
    </visual>
  </link>
</model>

    <!-- UAV 1 - SITL instance 0 - ports 9002/9003 -->
    <model name="iris_1_demo">
      <pose>0 2 0 0 0 0</pose>
      <include>
        <uri>model://iris_1</uri>
      </include>
    </model>

    <!-- UAV 2 - SITL instance 1 - ports 9012/9013 -->
    <model name="iris_2_demo">
      <pose>0 -2 0 0 0 0</pose>
      <include>
        <uri>model://iris_2</uri>
      </include>
    </model>

    <!-- UAV 3 - SITL instance 2 - ports 9022/9023 -->
    <model name="iris_3_demo">
      <pose>4 0 0 0 0 0</pose>
      <include>
        <uri>model://iris_3</uri>
      </include>
    </model>


    <!-- ══ Ground Control Station ═══════════════════════════════════════════
         Node 0 in the shared id convention (ROS id == NS-3 node id).
         The obstacle_raycast plugin now casts GCS<->UAV rays in addition to
         UAV<->UAV ones, so this link is finally modelled instead of being
         assumed permanently clear.

         The model origin is the base of the cabinet; the RF link starts at the
         antenna on top of the mast. That offset is <gcs_antenna_height> in the
         plugin block below (2.9 m = 0.9 m cabinet + 2.0 m mast) and must match
         world_pos_publisher.py's gcs_antenna_height parameter.

         The name must stay free of material keywords (glass/wood/concrete/
         metal/foliage/vehicle). The plugin filters this model out of ray hits
         by name, so a keyword here would never be read anyway, but a rename
         that dropped "gcs" would turn the station into an obstacle that
         blocks its own links. -->
    <model name="gcs">
      <static>true</static>
      <pose>0 6 0 0 0 0</pose>
      <link name="cabinet">
        <pose>0 0 0.45 0 0 0</pose>
        <collision name="cabinet_col">
          <geometry><box><size>1.2 1.2 0.9</size></box></geometry>
        </collision>
        <visual name="cabinet_vis">
          <geometry><box><size>1.2 1.2 0.9</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
      <link name="mast">
        <pose>0 0 1.9 0 0 0</pose>
        <collision name="mast_col">
          <geometry><cylinder><radius>0.05</radius><length>2.0</length></cylinder></geometry>
        </collision>
        <visual name="mast_vis">
          <geometry><cylinder><radius>0.05</radius><length>2.0</length></cylinder></geometry>
          <material><script><name>Gazebo/Yellow</name></script></material>
        </visual>
      </link>
    </model>

    <plugin name="obstacle_raycast" filename="libobstacle_raycast_plugin.so">
        <n_uavs>3</n_uavs>
        <uav_prefix>iris_</uav_prefix>
        <!-- ADDED: ground station becomes node 0, so the pair loop covers the
             three GCS<->UAV links as well as the three UAV<->UAV ones.
             gcs_antenna_height must match world_pos_publisher.py. -->
        <gcs_enabled>true</gcs_enabled>
        <gcs_model>gcs</gcs_model>
        <gcs_antenna_height>2.9</gcs_antenna_height>
    </plugin>

    <!-- Publishes ground-truth model poses on /gazebo/model_states so that
         world_pos_publisher.py can relay them to /uav_world_positions. This
         is what lets NS-3's UAV nodes track the drones as they fly (without
         it, NS-3 stays frozen at its initial formation). -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
        <ros>
            <namespace>/gazebo</namespace>
        </ros>
        <update_rate>20.0</update_rate>
    </plugin>


  </world>
</sdf>
