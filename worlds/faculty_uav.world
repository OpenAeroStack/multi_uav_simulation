    <!-- ============================================================ -->
    <!-- UAV MODELS                                                   -->
    <!-- Spawned at Admin Building front yard (near axes marker)      -->
    <!-- Separated 3m apart, 0.5m above ground                       -->
    <!-- ============================================================ -->

    <!-- UAV 1 - SITL instance 0 - ports 9002/9003 -->
    <!-- Z=39.3: terrain surface at (−3,8) ≈ 38.7m + 0.5m clearance -->
    <model name="iris_1_demo">
      <pose>-3 8 39.3 0 0 0</pose>
      <include>
        <uri>model://iris_1</uri>
      </include>
    </model>

    <!-- UAV 2 - SITL instance 1 - ports 9012/9013 (CLUSTER HEAD) -->
    <model name="iris_2_demo">
      <pose>0 8 39.3 0 0 0</pose>
      <include>
        <uri>model://iris_2</uri>
      </include>
    </model>

    <!-- UAV 3 - SITL instance 2 - ports 9022/9023 -->
    <model name="iris_3_demo">
      <pose>3 8 39.3 0 0 0</pose>
      <include>
        <uri>model://iris_3</uri>
      </include>
    </model>

