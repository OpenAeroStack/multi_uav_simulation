<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="mech_workshop_validation">

    <scene>
      <ambient>0.7 0.7 0.65 1</ambient>
      <background>0.6 0.8 1.0 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Mech Workshop, real-flight validation world -->
    <!-- GPS/world origin: real-flight launch pad.  The workshop assets are
         translated from their original building-corner frame so that the
         UAV can spawn at (0, 0) without changing the scene geometry. -->
    <!-- NOTE: elevation is approximated from faculty origin (31m ASL) -->
    <!-- not independently measured for this specific location -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>6.0773722</latitude_deg>
      <longitude_deg>80.1907552</longitude_deg>
      <elevation>31.0</elevation>
    </spherical_coordinates>

    <!-- ArduPilot-tuned physics for Sri Lanka -->
    <physics name='default_physics' default='0' type='ode'>
      <gravity>0 0 -9.7804</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.0</sor>
          <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.0</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <magnetic_field>6.0e-6 2.3e-5 -3.8e-5</magnetic_field>
    </physics>

    <atmosphere type='adiabatic'>
      <temperature>301</temperature>
      <pressure>101000</pressure>
      <temperature_gradient>-0.0065</temperature_gradient>
    </atmosphere>

    <!-- Ground with satellite texture -->
    <include>
      <uri>model://mech_workshop_ground</uri>
      <pose>26.59 -47.28 0 0 0 0</pose>
    </include>

    <!-- Mech Workshop building (visual only, not in obstacle model) -->
    <include>
      <uri>model://mech_workshop</uri>
      <pose>28.59 -47.28 0 0 0 0</pose>
    </include>

    <!-- UAV1 — world origin is the true launch pad / SITL HOME_GPS -->
    <model name="iris_1">
      <pose>0 0 0.1 0 0 -1.5708</pose>
      <include>
        <uri>model://iris_1</uri>
      </include>
    </model>

    <!-- Ground station — placed at approximate real flight launch/hover center -->
    <model name="gcs">
      <static>true</static>
      <pose>-2 0 0 0 0 0</pose>
      <link name="cabinet">
        <pose>0 0 0.45 0 0 0</pose>
        <collision name="cabinet_col">
          <geometry><box><size>1.2 1.2 0.9</size></box></geometry>
        </collision>
        <visual name="cabinet_vis">
          <geometry><box><size>1.2 1.2 0.9</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
      <link name="mast">
        <pose>0 0 1.9 0 0 0</pose>
        <collision name="mast_col">
          <geometry><cylinder><radius>0.05</radius><length>2.0</length></cylinder></geometry>
        </collision>
        <visual name="mast_vis">
          <geometry><cylinder><radius>0.05</radius><length>2.0</length></cylinder></geometry>
          <material><script><name>Gazebo/Yellow</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Publishes /link_obstacle_loss for the GCS-to-UAV link and draws its
         ray marker in Gazebo. The antenna height matches the GCS mast model. -->
    <plugin name="obstacle_raycast" filename="libobstacle_raycast_plugin.so">
      <n_uavs>1</n_uavs>
      <uav_prefix>iris_</uav_prefix>
      <gcs_enabled>true</gcs_enabled>
      <gcs_model>gcs</gcs_model>
      <gcs_antenna_height>2.9</gcs_antenna_height>
    </plugin>

  
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>20.0</update_rate>
    </plugin>
  </world>
</sdf>
