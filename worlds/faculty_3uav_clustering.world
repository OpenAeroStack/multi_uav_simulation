<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="default">

    <scene>
      <ambient>0.7 0.7 0.65 1</ambient>
      <background>0.6 0.8 1.0 1</background>
      <shadows>true</shadows>
      <sky>
        <time>10</time>
        <sunrise>6</sunrise>
        <sunset>18</sunset>
        <clouds>
         <speed>2</speed>
         <mean_size>0.5</mean_size>
        </clouds>
      </sky>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Faculty of Engineering, University of Ruhuna -->
    <!-- GPS Origin: Front entrance, Administration Building -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>6.0792673</latitude_deg>
      <longitude_deg>80.1921607</longitude_deg>
      <elevation>31.0</elevation>
    </spherical_coordinates>

    <!-- ArduPilot-tuned physics for Sri Lanka -->
    <physics name='default_physics' default='0' type='ode'>
      <!-- Sri Lanka actual gravity value at Hapugala, Galle -->
      <gravity>0 0 -9.7804</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.0</sor>
          <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.0</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <!-- Magnetic field: WMM2025 for Hapugala, Galle, Sri Lanka -->
      <!-- lat=6.08°N, lon=80.19°E, alt=31m -->
      <magnetic_field>6.0e-6 2.3e-5 -3.8e-5</magnetic_field>
    </physics>

    <!-- Atmosphere: Tropical, 31m ASL, Galle -->
    <atmosphere type='adiabatic'>
      <temperature>301</temperature>
      <pressure>101000</pressure>
      <temperature_gradient>-0.0065</temperature_gradient>
    </atmosphere>

    <!-- Campus world model (terrain + 17 buildings) -->
    <!-- Model pose: z=-31.412 aligns terrain surface with Gazebo z=0 -->
    <include>
      <uri>model://campus_world</uri>
      <pose>0 0 -31.412 0 0 0</pose>
    </include>

    <!-- Safety ground plane — prevents drones falling through world -->
    <!-- at z=-31.412 (terrain minimum elevation) -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -31.412 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2000 2000</size>
            </plane>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- 3 UAVs spawned at campus origin, spaced 3m apart on X axis  -->
    <!--                                                              -->
    <!-- UAV1: Cluster Head — hovers 60m above center                -->
    <!-- UAV2: Member North — patrols Main Gate / Guard Room area     -->
    <!-- UAV3: Member South — patrols Electrical Dept / Civil area    -->
    <!--                                                              -->
    <!-- Ports:                                                       -->
    <!--   UAV1: Gazebo 9002/9003  MAVLink 5760  DDS 2019            -->
    <!--   UAV2: Gazebo 9012/9013  MAVLink 5770  DDS 2020            -->
    <!--   UAV3: Gazebo 9022/9023  MAVLink 5780  DDS 2021            -->
    <!-- ============================================================ -->

    <model name="iris_1">
      <pose>0 0 0 0 0 0</pose>
      <include>
        <uri>model://iris_1</uri>
      </include>
    </model>

    <model name="iris_2">
      <pose>3 0 0 0 0 0</pose>
      <include>
        <uri>model://iris_2</uri>
      </include>
    </model>

    <model name="iris_3">
      <pose>6 0 0 0 0 0</pose>
      <include>
        <uri>model://iris_3</uri>
      </include>
    </model>

    <!-- Ground station: ~12m south of the UAV spawn line, centered under
         UAV2 (x=3). Offset south (-y) to stay clear of the Administration
         Building, which sits ~25m west / ~20m north of the origin per
         ground_truth_gps.csv. Gives GCS-to-UAV link ranges of ~12-12.4m,
         comparable in magnitude to city_3uav.world's tested 10-20m range. -->
    <model name="gcs">
      <static>true</static>
      <pose>3 -12 0 0 0 0</pose>
      <link name="cabinet">
        <pose>0 0 0.45 0 0 0</pose>
        <collision name="cabinet_col">
          <geometry><box><size>1.2 1.2 0.9</size></box></geometry>
        </collision>
        <visual name="cabinet_vis">
          <geometry><box><size>1.2 1.2 0.9</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
      <link name="mast">
        <pose>0 0 1.9 0 0 0</pose>
        <collision name="mast_col">
          <geometry>
            <cylinder><radius>0.05</radius><length>2.0</length></cylinder>
          </geometry>
        </collision>
        <visual name="mast_vis">
          <geometry>
            <cylinder><radius>0.05</radius><length>2.0</length></cylinder>
          </geometry>
          <material><script><name>Gazebo/Yellow</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Publishes /link_obstacle_loss for all six node pairs and draws their
         ray markers in Gazebo. gcs_antenna_height=2.9 carried over from
         city_3uav.world as a starting assumption — not yet verified against
         campus building heights, may need tuning. -->
    <plugin name="obstacle_raycast" filename="libobstacle_raycast_plugin.so">
      <n_uavs>3</n_uavs>
      <uav_prefix>iris_</uav_prefix>
      <gcs_enabled>true</gcs_enabled>
      <gcs_model>gcs</gcs_model>
      <gcs_antenna_height>2.9</gcs_antenna_height>
    </plugin>

    <!-- Publishes ground-truth poses on /gazebo/model_states. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>20.0</update_rate>
    </plugin>

  </world>
</sdf>
