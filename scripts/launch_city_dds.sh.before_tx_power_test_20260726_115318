run_ros_in_root() {
    bash -lc '
        set -e
        set +u
        source /opt/ros/humble/setup.bash
        for setup_file in "$1" "$2" "$3"; do
            [[ -f "$setup_file" ]] && source "$setup_file"
        done
        set -u
        export ROS_DOMAIN_ID=0
        export ROS2CLI_NO_DAEMON=1
        shift 3
        exec "$@"
    ' ros-root-shell \
    "$PROJECT_DIR/install/setup.bash" \
    "$PROJECT_DIR/ros2/install/setup.bash" \
    "$HOME/ardu_ws/install/setup.bash" \
    "$@"
}

show_obstacle_pipeline_diagnostics() {
    local topic="${1:-unknown}"

    echo "----- obstacle-pipeline diagnostics for $topic -----" >&2
    echo "Gazebo: PID=${GAZEBO_PID:-unset} log=$GAZEBO_LOG" >&2
    tail -n 100 "$GAZEBO_LOG" >&2 2>/dev/null || true
    echo "world_pos_publisher: PID=${WORLD_POS_PID:-unset} log=$WORLD_POS_LOG" >&2
    cat "$WORLD_POS_LOG" >&2 2>/dev/null || true
    echo "ns-3: PID=${NS3_PID:-unset} log=$NS3_LOG" >&2
    tail -n 100 "$NS3_LOG" >&2 2>/dev/null || true
    echo "Root ROS graph details for /uav_world_positions:" >&2
    run_ros_in_root ros2 topic info --verbose /uav_world_positions >&2 2>/dev/null || true
    echo "Root ROS graph details for /link_obstacle_loss:" >&2
    run_ros_in_root ros2 topic info --verbose /link_obstacle_loss >&2 2>/dev/null || true
    echo "----------------------------------------------------" >&2
}

wait_for_root_topic_publisher() {
    local topic="$1"
    local description="$2"
    local process_pid="${3:-}"
    local process_log="${4:-}"
    local deadline=$((SECONDS + OBSTACLE_READY_TIMEOUT_SEC))
    local info

    echo "Waiting for an active publisher on $topic ($description)..."
    while (( SECONDS < deadline )); do
        if [[ -n "$process_pid" ]] && ! kill -0 "$process_pid" 2>/dev/null; then
            echo "ERROR: $description exited during startup." >&2
            [[ -n "$process_log" ]] && cat "$process_log" >&2
            return 1
        fi
        if ! kill -0 "$GAZEBO_PID" 2>/dev/null; then
            echo "ERROR: Gazebo exited while waiting for $topic." >&2
            cat "$GAZEBO_LOG" >&2 || true
            return 1
        fi
        if info="$(run_ros_in_root ros2 topic info "$topic" 2>/dev/null)" &&
           awk '/Publisher count:/ { found=1; ok=(($3 + 0) > 0) }
                END { exit !(found && ok) }' <<<"$info"; then
            echo "Topic publisher ready: $topic"
            return 0
        fi
        sleep 0.2
    done

    echo "ERROR: No active publisher appeared on $topic within " \
         "${OBSTACLE_READY_TIMEOUT_SEC} seconds." >&2
    [[ -n "$process_log" ]] && cat "$process_log" >&2
    show_obstacle_pipeline_diagnostics "$topic"
    return 1
}

validate_world_position_payload() {
    local payload="$1"

    awk '
      function numeric(s) {
        return s ~ /^[-+]?[0-9]+([.][0-9]*)?([eE][-+]?[0-9]+)?$/ ||
               s ~ /^[-+]?[.][0-9]+([eE][-+]?[0-9]+)?$/
      }
      {
        gsub(/[\[\],]/, " ")
        for (i = 1; i <= NF; ++i)
          if (numeric($i)) values[++count] = $i
      }
      END {
        if (count == 0 || count % 4 != 0) exit 1
        for (i = 1; i <= count; i += 4) {
          id = values[i] + 0
          if (id != int(id) || id < 0 || id > 3) exit 1
          seen[id] = 1
        }
        for (id = 0; id <= 3; ++id)
          if (!seen[id]) exit 1
      }
    ' <<<"$payload"
}

validate_obstacle_loss_payload() {
    local payload="$1"

    awk '
      function numeric(s) {
        return s ~ /^[-+]?[0-9]+([.][0-9]*)?([eE][-+]?[0-9]+)?$/ ||
               s ~ /^[-+]?[.][0-9]+([eE][-+]?[0-9]+)?$/
      }
      {
        gsub(/[\[\],]/, " ")
        for (i = 1; i <= NF; ++i)
          if (numeric($i)) values[++count] = $i
      }
      END {
        if (count == 0 || count % 3 != 0) exit 1
        for (i = 1; i <= count; i += 3) {
          a = values[i] + 0
          b = values[i + 1] + 0
          loss = values[i + 2] + 0
          if (a != int(a) || b != int(b) || a < 0 || b > 3 || a >= b)
            exit 1
          if (!numeric(values[i + 2]) || loss < 0)
            exit 1
          pairs[a "-" b] = 1
        }
        required[1] = "0-1"; required[2] = "0-2"; required[3] = "0-3"
        required[4] = "1-2"; required[5] = "1-3"; required[6] = "2-3"
        for (i = 1; i <= 6; ++i)
          if (!pairs[required[i]]) exit 1
      }
    ' <<<"$payload"
}

receive_and_validate_pipeline_payload() {
    local topic="$1"
    local validator="$2"
    local description="$3"
    local payload

    echo "Receiving and validating one message from $topic..."
    if ! payload="$(run_ros_in_root timeout "$OBSTACLE_READY_TIMEOUT_SEC" \
        ros2 topic echo "$topic" std_msgs/msg/Float32MultiArray \
        --once --field data --full-length --flow-style 2>/dev/null)"; then
        echo "ERROR: Timed out receiving $description from $topic." >&2
        show_obstacle_pipeline_diagnostics "$topic"
        return 1
    fi
    if ! "$validator" "$payload"; then
        echo "ERROR: Invalid $description received from $topic:" >&2
        printf '%s\n' "$payload" >&2
        show_obstacle_pipeline_diagnostics "$topic"
        return 1
    fi
    echo "Payload valid: $topic"
}

wait_for_ns3_integration_check() {
    local deadline=$((SECONDS + NS3_INTEGRATION_TIMEOUT_SEC))

    echo "Waiting for the ns-3 integration check..."
    while (( SECONDS < deadline )); do
        if ! kill -0 "$NS3_PID" 2>/dev/null; then
            echo "ERROR: ns-3 exited before its integration check completed." >&2
            show_obstacle_pipeline_diagnostics /ns3_link_rssi
            return 1
        fi
        if grep -Fq '[integration check] FAILED:' "$NS3_LOG"; then
            echo "ERROR: ns-3 integration check reached its final timeout." >&2
            show_obstacle_pipeline_diagnostics /link_obstacle_loss
            return 1
        fi
        if grep -Fq '[integration check] OK:' "$NS3_LOG"; then
            echo "ns-3 integration check passed."
            return 0
        fi
        sleep 0.2
    done

    echo "ERROR: Timed out after ${NS3_INTEGRATION_TIMEOUT_SEC}s waiting for the ns-3 integration-check result." >&2
    show_obstacle_pipeline_diagnostics /ns3_link_rssi
    return 1
}

wait_for_root_topic_publisher \
    /gazebo/model_states "Gazebo model-state plugin" \
    "$GAZEBO_PID" "$GAZEBO_LOG"

if pgrep -u "$(id -u "$RUN_USER")" -f '[w]orld_pos_publisher.py' >/dev/null; then
    echo "ERROR: world_pos_publisher.py is already running; refusing to start a duplicate." >&2
    exit 1
fi

: >"$WORLD_POS_LOG"
run_ros_in_root \
    python3 "$PROJECT_DIR/scripts/world_pos_publisher.py" \
    --ros-args \
    -p model_states_topic:=/gazebo/model_states \
    -p uav_prefix:=iris_ \
    -p n_uavs:=3 \
    -p rate_hz:=10.0 \
    -p gcs_enabled:=true \
    -p gcs_model:=gcs \
    -p gcs_antenna_height:=2.9 \
    -p stale_after:=2.0 \
    >"$WORLD_POS_LOG" 2>&1 &
WORLD_POS_PID=$!

sleep 1
if ! kill -0 "$WORLD_POS_PID" 2>/dev/null; then
    echo "ERROR: world_pos_publisher.py exited during startup." >&2
    cat "$WORLD_POS_LOG" >&2 || true
    exit 1
fi
echo "world_pos_publisher started in root namespace: PID=$WORLD_POS_PID log=$WORLD_POS_LOG"

wait_for_root_topic_publisher \
    /uav_world_positions "world position publisher" \
    "$WORLD_POS_PID" "$WORLD_POS_LOG"

validate_obstacle_pipeline() {
    echo "=== Validating root ROS obstacle pipeline ==="
    wait_for_root_topic_publisher \
        /gazebo/model_states "Gazebo model-state plugin"
    wait_for_root_topic_publisher \
        /uav_world_positions "world position publisher" \
        "$WORLD_POS_PID" "$WORLD_POS_LOG"
    wait_for_root_topic_publisher \
        /link_obstacle_loss "Gazebo obstacle ray-cast plugin"
    wait_for_root_topic_publisher \
        /ns3_link_rssi "integrated ns-3 RSSI publisher" \
        "$NS3_PID" "$NS3_LOG"
    wait_for_root_topic_publisher \
        /ns3_link_snr "integrated ns-3 SNR publisher" \
        "$NS3_PID" "$NS3_LOG"

    receive_and_validate_pipeline_payload \
        /uav_world_positions validate_world_position_payload \
        "world-position payload containing node IDs 0,1,2,3"
    receive_and_validate_pipeline_payload \
        /link_obstacle_loss validate_obstacle_loss_payload \
        "six-link obstacle-loss payload with finite non-negative losses"
    wait_for_ns3_integration_check
    echo "Obstacle pipeline ready."
    start_gazebo_gui_once


}

validate_obstacle_pipeline

launch_sitl() {
    local namespace="$1"
    local instance="$2"
    local sysid="$3"
    local mavlink_port="$4"
    local gazebo_ip="$5"
    local defaults="$6"

    local work_dir="/tmp/multi_uav_sitl/$namespace"
    local log_file="$work_dir/arducopter.log"
    local pid_file="$work_dir/arducopter.pid"
    local exit_file="$work_dir/arducopter.exit"
    local wrapper_pid
    local actual_pid
    local group_name

    group_name="$(id -gn "$RUN_USER")"

    mkdir -p "$work_dir"

    # Correct ownership of both the directory and any files left by an
    # earlier failed run.
    chown -R "$RUN_USER:$group_name" "$work_dir"

    rm -f "$pid_file" "$exit_file"
    : >"$log_file"
    chown "$RUN_USER:$group_name" "$log_file"

    sudo ip netns exec "$namespace" \
        sudo -H -u "$RUN_USER" \
        bash -c '
            work_dir="$1"
            log_file="$2"
            pid_file="$3"
            exit_file="$4"
            shift 4

            cd "$work_dir" || exit 90

            rm -f "$exit_file"

            # Prevent a detached background SITL process from interacting
            # with the launcher terminal input.
            exec </dev/null

            stdbuf -oL -eL "$@" >>"$log_file" 2>&1 &
            child_pid=$!

            printf "%s\n" "$child_pid" >"$pid_file"

            set +e
            wait "$child_pid"
            status=$?
            set -e

            printf "%s\n" "$status" >"$exit_file"
            exit "$status"
        ' sitl-shell \
        "$work_dir" \
        "$log_file" \
        "$pid_file" \
        "$exit_file" \
        "$BINARY" \
        --model gazebo-iris \
        --speedup 1 \
        --sysid "$sysid" \
        --instance "$instance" \
        --defaults "$defaults" \
        --sim-address "$gazebo_ip" \
        --home "$HOME_GPS" \
        --serial0="tcp:0.0.0.0:$mavlink_port" \
        >/dev/null 2>&1 &

    wrapper_pid=$!

    # Wait for the namespace shell to publish the real ArduCopter PID.
    local deadline=$((SECONDS + 10))

    while [[ ! -s "$pid_file" ]]; do
        if ! kill -0 "$wrapper_pid" 2>/dev/null; then
            set +e
            wait "$wrapper_pid"
            local wrapper_status=$?
            set -e

            echo "ERROR: $namespace SITL wrapper exited before publishing the ArduCopter PID." >&2
            echo "Wrapper status: $wrapper_status" >&2
            echo "----- $log_file -----" >&2
            cat "$log_file" >&2 || true
            echo "---------------------" >&2
            return 1
        fi

        if (( SECONDS >= deadline )); then
            echo "ERROR: Timed out waiting for $namespace ArduCopter PID file:" >&2
            echo "  $pid_file" >&2
            return 1
        fi

        sleep 0.1
    done

    actual_pid="$(tr -dc '0-9' <"$pid_file")"

    if [[ -z "$actual_pid" ]]; then
        echo "ERROR: Invalid ArduCopter PID file for $namespace:" >&2
        cat "$pid_file" >&2 || true
        return 1
    fi

    SITL_PIDS+=("$actual_pid")

    echo "Started $namespace ArduCopter:"
    echo "  actual PID=$actual_pid"
    echo "  wrapper PID=$wrapper_pid"
    echo "  log=$log_file"
}


wait_for_sitl_ready() {
    local namespace="$1"
    local udp_port="$2"
    local process_pid="$3"
    local log_file="$4"

    local work_dir
    local exit_file
    local deadline
    local exit_code

    work_dir="$(dirname "$log_file")"
    exit_file="$work_dir/arducopter.exit"
    deadline=$((SECONDS + 60))

    echo "Waiting for $namespace SITL UDP port $udp_port..."

    while (( SECONDS < deadline )); do
        # Check the actual ArduCopter process, not the outer sudo wrapper.
        if ! kill -0 "$process_pid" 2>/dev/null; then
            exit_code="unknown"

            if [[ -r "$exit_file" ]]; then
                exit_code="$(tr -dc '0-9' <"$exit_file")"
                [[ -n "$exit_code" ]] || exit_code="unknown"
            fi

            echo "ERROR: $namespace ArduCopter exited during startup." >&2
            echo "ArduCopter PID: $process_pid" >&2
            echo "ArduCopter exit code: $exit_code" >&2

            echo "----- $log_file -----" >&2
            cat "$log_file" >&2 || true
            echo "---------------------" >&2

            echo "----- Gazebo messages for $namespace -----" >&2
            grep -iE \
                "$namespace|iris_[123]|ArduPilot|Broken.*connection" \
                "${GAZEBO_LOG:-/tmp/gazebo_city.log}" |
                tail -n 80 >&2 || true
            echo "------------------------------------------" >&2

            return 1
        fi

        if sudo ip netns exec "$namespace" \
            ss -H -lun "sport = :$udp_port" |
            grep -q .; then

            echo "✓ $namespace ArduCopter is alive; UDP port $udp_port is open"
            return 0
        fi

        sleep 0.25
    done

    echo "ERROR: $namespace ArduCopter is alive, but UDP port $udp_port did not open." >&2
    echo "ArduCopter PID: $process_pid" >&2

    echo "----- Processes inside $namespace -----" >&2
    local namespace_pids
    namespace_pids="$(sudo ip netns pids "$namespace" | paste -sd, -)"

    if [[ -n "$namespace_pids" ]]; then
        ps -o pid,ppid,user,stat,etime,%cpu,%mem,cmd \
            -p "$namespace_pids" >&2 || true
    else
        echo "No processes found." >&2
    fi

    echo "----- Network sockets inside $namespace -----" >&2
    sudo ip netns exec "$namespace" ss -lntup >&2 || true

    echo "----- $log_file -----" >&2
    cat "$log_file" >&2 || true
    echo "---------------------" >&2

    return 1
}


start_micro_ros_agent() {
    local uav_number="$1"
    local port="$2"
    local log_file="$3"

    : >"$log_file"
    sudo ip netns exec gcsns \
        sudo -H -u "$RUN_USER" \
        bash -lc '
            set -e
            set +u
            source /opt/ros/humble/setup.bash
            source "$1"
            source "$2"
            set -u
            exec ros2 run micro_ros_agent micro_ros_agent udp4 --port "$3"
        ' agent-shell \
        "$HOME/ardu_ws/install/setup.bash" \
        "$PROJECT_DIR/ros2/install/setup.bash" \
        "$port" \
        >"$log_file" 2>&1 &

    AGENT_PIDS+=("$!")
    echo "Started UAV$uav_number micro_ros_agent: PID=$! UDP=$port log=$log_file"
}

agent_port_is_ready() {
    local port="$1"
    sudo ip netns exec gcsns ss -H -lun "sport = :$port" | grep -q .
}

echo "=== Starting micro_ros_agent instances inside gcsns ==="
for i in "${!AGENT_PORTS[@]}"; do
    start_micro_ros_agent "$((i + 1))" "${AGENT_PORTS[$i]}" "${AGENT_LOGS[$i]}"
done

echo "Waiting for micro_ros_agent UDP ports inside gcsns..."
deadline=$((SECONDS + AGENT_READY_TIMEOUT_SEC))
while true; do
    pending=()
    for i in "${!AGENT_PIDS[@]}"; do
        if ! kill -0 "${AGENT_PIDS[$i]}" 2>/dev/null; then
            echo "ERROR: UAV$((i + 1)) micro_ros_agent exited early." >&2
            echo "----- ${AGENT_LOGS[$i]} -----" >&2
            cat "${AGENT_LOGS[$i]}" >&2 || true
            echo "-----------------------------" >&2
            exit 1
        fi
        if ! agent_port_is_ready "${AGENT_PORTS[$i]}"; then
            pending+=("${AGENT_PORTS[$i]}")
        fi
    done

    if [[ ${#pending[@]} -eq 0 ]]; then
        break
    fi
    if (( SECONDS >= deadline )); then
        echo "ERROR: Timed out waiting for gcsns UDP ports: ${pending[*]}" >&2
        for log_file in "${AGENT_LOGS[@]}"; do
            echo "----- $log_file -----" >&2
            cat "$log_file" >&2 || true
        done
        exit 1
    fi
    sleep 0.2
done

echo "micro_ros_agent ports ready inside gcsns:"
sudo ip netns exec gcsns ss -lunp \
    "( sport = :2019 or sport = :2020 or sport = :2021 )"
# BEGIN GAZEBO FDM READINESS GATE
wait_for_gazebo_fdm_ports 60
# END GAZEBO FDM READINESS GATE

echo "=== Starting namespaced SITL instances sequentially ==="

echo "--- Starting UAV1 SITL ---"
launch_sitl uav1 0 1 5760 172.31.1.1 "$UAV1_DEFAULTS"

wait_for_sitl_ready \
    uav1 9003 "${SITL_PIDS[0]}" \
    /tmp/multi_uav_sitl/uav1/arducopter.log

echo "UAV1 SITL startup complete."
sleep 2

echo "--- Starting UAV2 SITL ---"
launch_sitl uav2 1 2 5770 172.31.2.1 "$UAV2_DEFAULTS"

wait_for_sitl_ready \
    uav2 9013 "${SITL_PIDS[1]}" \
    /tmp/multi_uav_sitl/uav2/arducopter.log

echo "UAV2 SITL startup complete."
sleep 2

echo "--- Starting UAV3 SITL ---"
launch_sitl uav3 2 3 5780 172.31.3.1 "$UAV3_DEFAULTS"

wait_for_sitl_ready \
    uav3 9023 "${SITL_PIDS[2]}" \
    /tmp/multi_uav_sitl/uav3/arducopter.log

echo "UAV3 SITL startup complete."
echo "All three SITL instances are running."

run_ros_in_gcsns() {
    sudo ip netns exec gcsns \
        sudo -H -u "$RUN_USER" \
        bash -lc '
            set -e
            set +u
            source /opt/ros/humble/setup.bash
            source "$1"
            source "$2"
            set -u
            export ROS_DOMAIN_ID="$3"
            export ROS2CLI_NO_DAEMON=1
            shift 3
            exec "$@"
        ' ros-shell \
        "$HOME/ardu_ws/install/setup.bash" \
        "$PROJECT_DIR/ros2/install/setup.bash" \
        "$ROS_DOMAIN_ID" "$@"
}

gps_message_is_valid() {
    awk -F ': *' '
        /^[[:space:]]*latitude:/  { lat=$2; gsub(/[[:space:]]/, "", lat) }
        /^[[:space:]]*longitude:/ { lon=$2; gsub(/[[:space:]]/, "", lon) }
        END {
            number="^-?[0-9]+([.][0-9]+)?([eE][+-]?[0-9]+)?$"
            if (lat !~ number || lon !~ number) exit 1
            if (lat < -90 || lat > 90 || lon < -180 || lon > 180) exit 1
            if ((lat + 0) == 0 && (lon + 0) == 0) exit 1
            exit 0
        }
    '
}

show_dds_diagnostics() {
    local uav_number="$1"
    local topic="$2"
    local sitl_log="/tmp/multi_uav_sitl/uav$uav_number/arducopter.log"
    local agent_log="${AGENT_LOGS[$((uav_number - 1))]}"

    echo "ERROR: DDS GPS readiness failed for UAV$uav_number ($topic)." >&2
    echo "----- SITL log: $sitl_log -----" >&2
    if [[ -r "$sitl_log" ]]; then
        tail -n 80 "$sitl_log" >&2
    else
        echo "SITL log is absent or unreadable." >&2
    fi
    echo "----- micro_ros_agent log: $agent_log -----" >&2
    if [[ -r "$agent_log" ]]; then
        tail -n 80 "$agent_log" >&2
    else
        echo "micro_ros_agent log is absent or unreadable." >&2
    fi
    echo "----- gcsns UDP sockets -----" >&2
    sudo ip netns exec gcsns ss -lunp >&2 || true
    echo "----- gcsns routes -----" >&2
    sudo ip netns exec gcsns ip route show >&2 || true
    echo "----- gcsns interfaces -----" >&2
    sudo ip netns exec gcsns ip -details -statistics address show >&2 || true
    echo "--------------------------------" >&2
}

wait_for_dds_gps() {
    local uav_number="$1"
    local topic="/ap/v$uav_number/navsat"
    local deadline=$((SECONDS + DDS_TOPIC_TIMEOUT_SEC))
    local info message
    local publisher_seen=false

    echo "Waiting for an active publisher and valid GPS on $topic..."
    while (( SECONDS < deadline )); do
        if info="$(run_ros_in_gcsns ros2 topic info "$topic" 2>/dev/null)" &&
           awk '/Publisher count:/ { found=1; ok=(($3 + 0) > 0) } END { exit !(found && ok) }' \
               <<<"$info"; then
            publisher_seen=true
            if message="$(run_ros_in_gcsns timeout 3 ros2 topic echo \
                "$topic" sensor_msgs/msg/NavSatFix --once 2>/dev/null)" &&
               gps_message_is_valid <<<"$message"; then
                echo "DDS GPS ready: $topic"
                return 0
            fi
        fi
        sleep 0.5
    done

    if [[ "$publisher_seen" == false ]]; then
        echo "No active publisher appeared for $topic within ${DDS_TOPIC_TIMEOUT_SEC}s." >&2
    else
        echo "Publisher exists for $topic, but no valid GPS message arrived within ${DDS_TOPIC_TIMEOUT_SEC}s." >&2
    fi
    show_dds_diagnostics "$uav_number" "$topic"
    return 1
}

echo "=== Verifying namespaced AP_DDS GPS telemetry ==="
for uav_number in 1 2 3; do
    if ! wait_for_dds_gps "$uav_number"; then
        echo "Aborting before city_mission because UAV$uav_number DDS GPS is not ready." >&2
        exit 1
    fi
done

sitl_tcp_is_reachable() {
    local host="$1"
    local port="$2"

    sudo ip netns exec gcsns \
        sudo -H -u "$RUN_USER" \
        timeout 1 bash -c 'exec 3<>"/dev/tcp/$1/$2"' sitl-probe \
        "$host" "$port" 2>/dev/null
}

wait_for_sitl_tcp() {
    local uav_number="$1"
    local host="$2"
    local port="$3"
    local deadline=$((SECONDS + SITL_REACHABLE_TIMEOUT_SEC))

    echo "Waiting for UAV$uav_number SITL at $host:$port from gcsns..."
    until sitl_tcp_is_reachable "$host" "$port"; do
        if ! kill -0 "$NS3_PID" 2>/dev/null; then
            dump_ns3_failure
            exit 1
        fi
        if (( SECONDS >= deadline )); then
            echo "ERROR: UAV$uav_number SITL is not reachable from gcsns at $host:$port" >&2
            exit 1
        fi
        sleep 0.2
    done
    echo "UAV$uav_number SITL reachable at $host:$port"
}

start_drone_bridge() {
    local uav_number="$1"
    local node_name="$2"
    local mavlink_host="$3"
    local mavlink_port="$4"
    local takeoff_altitude="$5"
    local log_file="$6"

    : >"$log_file"
    sudo ip netns exec gcsns \
        sudo -H -u "$RUN_USER" \
        bash -lc '
            set -e
            set +u
            source /opt/ros/humble/setup.bash
            source "$1"
            source "$2"
            set -u
            export ROS_DOMAIN_ID="$3"
            exec ros2 run uav_controller drone_bridge --ros-args \
                -r "__node:=$4" \
                -p "uav_id:=$5" \
                -p "mavlink_host:=$6" \
                -p "mavlink_port:=$7" \
                -p "takeoff_altitude:=$8"
        ' bridge-shell \
        "$HOME/ardu_ws/install/setup.bash" \
        "$PROJECT_DIR/ros2/install/setup.bash" \
        "$ROS_DOMAIN_ID" "$node_name" "$uav_number" \
        "$mavlink_host" "$mavlink_port" "$takeoff_altitude" \
        >"$log_file" 2>&1 &

    BRIDGE_PIDS+=("$!")
    sleep 1
    if ! kill -0 "$!" 2>/dev/null; then
        echo "ERROR: $node_name exited during startup." >&2
        cat "$log_file" >&2 || true
        exit 1
    fi
    echo "Started $node_name: PID=$! MAVLink=$mavlink_host:$mavlink_port log=$log_file"
}

echo "=== Starting drone_bridge nodes inside gcsns (ROS_DOMAIN_ID=$ROS_DOMAIN_ID) ==="
wait_for_sitl_tcp 1 10.42.0.11 5760
start_drone_bridge 1 drone_bridge_uav1 10.42.0.11 5760 60.0 "${BRIDGE_LOGS[0]}"

wait_for_sitl_tcp 2 10.42.0.12 5770
start_drone_bridge 2 drone_bridge_uav2 10.42.0.12 5770 40.0 "${BRIDGE_LOGS[1]}"

wait_for_sitl_tcp 3 10.42.0.13 5780
start_drone_bridge 3 drone_bridge_uav3 10.42.0.13 5780 50.0 "${BRIDGE_LOGS[2]}"

verify_mission_prerequisites() {
    local i

    kill -0 "$NS3_PID" 2>/dev/null || {
        dump_ns3_failure
        return 1
    }
    kill -0 "$GAZEBO_PID" 2>/dev/null || {
        echo "ERROR: Gazebo is not running; log: $GAZEBO_LOG" >&2
        cat "$GAZEBO_LOG" >&2 || true
        return 1
    }
    kill -0 "$WORLD_POS_PID" 2>/dev/null || {
        echo "ERROR: world_pos_publisher is not running; log: $WORLD_POS_LOG" >&2
        cat "$WORLD_POS_LOG" >&2 || true
        return 1
    }
    for i in "${!SITL_PIDS[@]}"; do
        kill -0 "${SITL_PIDS[$i]}" 2>/dev/null || {
            echo "ERROR: UAV$((i + 1)) SITL is not running; log: ${SITL_LOGS[$i]}" >&2
            cat "${SITL_LOGS[$i]}" >&2 || true
            return 1
        }
    done
    for i in "${!AGENT_PIDS[@]}"; do
        kill -0 "${AGENT_PIDS[$i]}" 2>/dev/null || {
            echo "ERROR: UAV$((i + 1)) micro_ros_agent is not running." >&2
            return 1
        }
    done
    for i in "${!BRIDGE_PIDS[@]}"; do
        kill -0 "${BRIDGE_PIDS[$i]}" 2>/dev/null || {
            echo "ERROR: UAV$((i + 1)) drone_bridge is not running." >&2
            return 1
        }
    done
    validate_obstacle_pipeline
}

start_city_mission() {
    if sudo ip netns exec gcsns \
        pgrep -u "$(id -u "$RUN_USER")" -f '[c]ity_mission' >/dev/null; then
        echo "ERROR: A city_mission process is already running; refusing to start a duplicate." >&2
        return 1
    fi

    : >"$MISSION_LOG"
    sudo ip netns exec gcsns \
        sudo -H -u "$RUN_USER" \
        bash -lc '
            set -e
            set +u
            source /opt/ros/humble/setup.bash
            source "$1"
            source "$2"
            set -u
            export ROS_DOMAIN_ID="$3"
            exec ros2 run uav_controller city_mission
        ' mission-shell \
        "$HOME/ardu_ws/install/setup.bash" \
        "$PROJECT_DIR/ros2/install/setup.bash" \
        "$ROS_DOMAIN_ID" \
        >"$MISSION_LOG" 2>&1 &
    MISSION_PID=$!

    sleep 1
    if ! kill -0 "$MISSION_PID" 2>/dev/null; then
        echo "ERROR: city_mission exited during startup." >&2
        cat "$MISSION_LOG" >&2 || true
        return 1
    fi
    echo "city_mission started: PID=$MISSION_PID log=$MISSION_LOG"
}

echo "=== Final prerequisite check and city_mission startup ==="
verify_mission_prerequisites
start_city_mission

MISSION_DEADLINE=$((SECONDS + MISSION_TIMEOUT_SEC))
MISSION_LAST_REPORT=$SECONDS

echo "Mission watchdog enabled: ${MISSION_TIMEOUT_SEC}s"
echo "Mission log: $MISSION_LOG"

while kill -0 "$MISSION_PID" 2>/dev/null; do
    if ! kill -0 "$NS3_PID" 2>/dev/null; then
        dump_ns3_failure
        exit 1
    fi

    if (( SECONDS >= MISSION_DEADLINE )); then
        echo "ERROR: city_mission exceeded ${MISSION_TIMEOUT_SEC}s." >&2
        echo "The mission process is still running and did not report completion." >&2
        echo "----- Last city_mission messages -----" >&2
        tail -n 120 "$MISSION_LOG" >&2 || true
        echo "--------------------------------------" >&2
        exit 124
    fi

    if (( SECONDS - MISSION_LAST_REPORT >= 30 )); then
        echo
        echo "city_mission is still running. Recent messages:"
        tail -n 8 "$MISSION_LOG" 2>/dev/null || true
        MISSION_LAST_REPORT=$SECONDS
    fi

    sleep 1
done

set +e
wait "$MISSION_PID"
mission_status=$?
set -e
if (( mission_status != 0 )); then
    echo "ERROR: city_mission exited with status $mission_status; initiating cleanup." >&2
    echo "----- $MISSION_LOG -----" >&2
    cat "$MISSION_LOG" >&2 || true
    echo "------------------------" >&2
    exit "$mission_status"
fi

echo "city_mission completed successfully; initiating cleanup."
