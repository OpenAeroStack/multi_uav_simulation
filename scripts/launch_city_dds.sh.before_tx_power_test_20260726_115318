fi
OBSTACLE_PLUGIN_DIR="$(dirname "$OBSTACLE_PLUGIN_FILE")"
export GAZEBO_PLUGIN_PATH="$OBSTACLE_PLUGIN_DIR${GAZEBO_PLUGIN_PATH:+:$GAZEBO_PLUGIN_PATH}"

echo "Selected obstacle plugin file: $OBSTACLE_PLUGIN_FILE"
echo "Selected obstacle plugin directory: $OBSTACLE_PLUGIN_DIR"
echo "Final GAZEBO_PLUGIN_PATH: $GAZEBO_PLUGIN_PATH"

plugin_dependencies="$(ldd "$OBSTACLE_PLUGIN_FILE" 2>&1)" || {
