<?xml version="1.0" encoding="UTF-8" ?>
<dds>
    <profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
        <transport_descriptors>
            <transport_descriptor>
                <transport_id>three_uav_ns3_udpv4</transport_id>
                <type>UDPv4</type>
                <!-- Cover all expected participant IDs when peer ports are omitted. -->
                <maxInitialPeersRange>32</maxInitialPeersRange>
                <!-- In each netns, only its locally assigned address is retained. -->
                <interfaceWhiteList>
                    <address>10.42.0.10</address>
                    <address>10.42.0.11</address>
                    <address>10.42.0.12</address>
                    <address>10.42.0.13</address>
                </interfaceWhiteList>
            </transport_descriptor>
        </transport_descriptors>

        <participant profile_name="three_uav_ns3_participant" is_default_profile="true">
            <rtps>
                <builtin>
                    <!-- Explicit unicast seeds avoid dependence on RTPS multicast. -->
                    <initialPeersList>
                        <locator><udpv4><address>10.42.0.10</address></udpv4></locator>
                        <locator><udpv4><address>10.42.0.11</address></udpv4></locator>
                        <locator><udpv4><address>10.42.0.12</address></udpv4></locator>
                        <locator><udpv4><address>10.42.0.13</address></udpv4></locator>
                    </initialPeersList>
                </builtin>
                <userTransports>
                    <transport_id>three_uav_ns3_udpv4</transport_id>
                </userTransports>
                <!-- Disable SHM and the unrestricted default UDP transport. -->
                <useBuiltinTransports>false</useBuiltinTransports>
            </rtps>
        </participant>
    </profiles>
</dds>
