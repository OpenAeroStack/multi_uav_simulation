          <float_array id="AdminRoof-mesh-positions-array" count="18">
            131.454 44.433 53.55646
            118.123 26.272 53.55646
            160.610 -4.908 53.55646
            173.930 13.244 53.55646
            133.867 28.691 57.55646
            158.192 10.830 57.55646
          </float_array>
          <technique_common>
            <accessor source="#AdminRoof-mesh-positions-array" count="6" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <source id="AdminRoof-mesh-normals">
