            -0.2697  0.1980  0.9423
             0.2699 -0.1980  0.9423
             0.1981  0.2699  0.9423
            -0.1981 -0.2699  0.9423
          </float_array>
          <technique_common>
            <accessor source="#AdminRoof-mesh-normals-array" count="4" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="AdminRoof-mesh-vertices">
