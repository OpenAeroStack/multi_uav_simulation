PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
RUN_USER="${SUDO_USER:-$USER}"
NS3_LOG="/tmp/ns3_stdout.log"
MISSION_TIMEOUT_SEC="${MISSION_TIMEOUT_SEC:-900}"
TAP_READY_TIMEOUT_SEC="${TAP_READY_TIMEOUT_SEC:-120}"
